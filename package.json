{
  "name": "lead-magnet-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sample Report Generator data pipeline scripts (see docs/pipeline-steps.md)",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --experimental-strip-types --watch main.ts",
    "start": "node --env-file=.env --experimental-strip-types main.ts",
    "typecheck": "tsc --noEmit",
    "pipeline": "node --env-file=.env --experimental-strip-types scripts/cli.ts",
    "parse": "node --experimental-strip-types scripts/parse/run.ts",
    "normalize": "node --experimental-strip-types scripts/normalize/run.ts",
    "aggregate": "node --experimental-strip-types scripts/aggregate/run.ts",
    "brief": "node --experimental-strip-types scripts/brief/run.ts",
    "narrative": "node --env-file=.env --experimental-strip-types scripts/narrative/run.ts",
    "assemble": "node --experimental-strip-types scripts/assemble/run.ts",
    "pdf": "node --experimental-strip-types scripts/pdf/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@supabase/supabase-js": "^2.112.0",
    "hono": "^4.12.34",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}