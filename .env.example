# Copy to backend/.env and fill in. Loaded via Node's built-in --env-file flag.

# Step 5 (narrative) — the only step that calls an LLM.
MISTRAL_API_KEY=
# Optional: defaults to "mistral". Set to "anthropic" once providers/anthropic.ts exists.
LLM_PROVIDER=mistral

# Supabase (project: lead-magnet). Optional — the pipeline runs on local
# checkpoint files when these are unset; see backend/db/client.ts.
# SUPABASE_SERVICE_ROLE_KEY is a full-access secret: server-side only,
# never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://jayhzcrgvjfotmkvnwhz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Static admin login (v1 has exactly one account — see docs/project.md, no user
# table). Gates uploads, pipeline runs, and report reads (api/middleware/requireAuth.ts).
# Change ADMIN_PASSWORD and set a real SESSION_SECRET before this is reachable
# from anywhere but your own machine.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Any long random string — signs the session cookie. Required in production;
# falls back to a fixed, publicly-known dev value if unset (see core/session.ts).
SESSION_SECRET=

# Used by the PDF export step to reach the frontend, and to authenticate the
# headless browser that does the printing. Defaults to http://localhost:3000.
FRONTEND_URL=http://localhost:3000
