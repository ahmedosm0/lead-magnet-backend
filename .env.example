# Copy to backend/.env and fill in. Loaded via Node's built-in --env-file flag.

# Step 5 (narrative) — the only step that calls an LLM.
MISTRAL_API_KEY=
# Optional: defaults to "mistral". Set to "anthropic" once providers/anthropic.ts exists.
LLM_PROVIDER=mistral

# Supabase (project: lead-magnet). Optional — the pipeline runs on local
# checkpoint files when these are unset; see backend/db/client.ts.
# SUPABASE_SERVICE_ROLE_KEY is a full-access secret: server-side only,
# never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://jayhzcrgvjfotmkvnwhz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
